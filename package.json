{
  "name": "comos-pay-community-server",
  "version": "1.5.1",
  "description": "Cosmos Pay — payments microservice (NestJS + Prisma) behind the APISIX gateway",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "prisma generate && nest build && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "prisma migrate deploy && nest start --watch --exec \"node --no-node-snapshot\"",
    "start": "nest start --exec \"node --no-node-snapshot\"",
    "dev:local": "node --no-node-snapshot --disable-warning=ExperimentalWarning --experimental-strip-types scripts/dev-local.mts",
    "start:dev": "nest start --watch --exec \"node --no-node-snapshot\"",
    "start:debug": "nest start --debug --watch --exec \"node --no-node-snapshot\"",
    "start:prod": "node --no-node-snapshot dist/src/main",
    "lint": "eslint \"{src,apps,libs,scripts,test,plugins}/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"{src,apps,libs,scripts,test,plugins}/**/*.ts\" --fix",
    "test": "node --no-node-snapshot --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --no-node-snapshot --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:e2e": "node --no-node-snapshot --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "openapi:generate": "ts-node -r tsconfig-paths/register --transpile-only scripts/generate-openapi.ts",
    "openapi:check": "npm run openapi:generate && git diff --exit-code -- openapi/openapi.json openapi/openapi.yaml",
    "readme:check": "ts-node -r tsconfig-paths/register --transpile-only scripts/check-readme-routes.ts",
    "backups:reencrypt": "ts-node -r tsconfig-paths/register --transpile-only scripts/reencrypt-wallet-backups.ts",
    "webhooks:audit-destinations": "ts-node -r tsconfig-paths/register --transpile-only scripts/mark-blocked-webhook-endpoints.ts",
    "seed:request-logs": "ts-node -r tsconfig-paths/register --transpile-only scripts/seed-request-logs.ts",
    "plugins": "node --no-node-snapshot -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/plugins.ts",
    "assets:verify": "ts-node -r tsconfig-paths/register --transpile-only scripts/verify-assets.ts",
    "import:platform-wallet-data": "ts-node -r tsconfig-paths/register --transpile-only scripts/import-platform-wallet-data.ts",
    "contracts:compile": "ts-node -r tsconfig-paths/register --transpile-only scripts/compile-contracts.ts && prettier --write src/evm/payment-forwarder.artifact.ts"
  },
  "dependencies": {
    "@defindex/sdk": "^0.3.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@stellar/stellar-sdk": "^17.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.5",
    "eventemitter2": "^6.4.9",
    "helmet": "^8.3.0",
    "isolated-vm": "^7.0.1",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "solc": "0.8.37",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.5",
    "tsconfig-paths": "^4.2.0",
    "typescript-eslint": "^8.71.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "multer": "^2.3.0",
    "@hono/node-server": "^1.19.15",
    "deepmerge-ts": "^8.0.2",
    "valibot": "^1.4.2",
    "mysql2": "^3.22.0",
    "browserslist": "^4.28.7",
    "solc": {
      "tmp": "0.2.7"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@generated/(.*)$": "<rootDir>/../generated/$1"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
