{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // No `baseUrl`: TypeScript 6 deprecates it and 7 drops it. Without one,
    // `paths` resolve relative to THIS file, so the entries are written as
    // explicit "./" paths. Four other places consume this mapping — jest's
    // moduleNameMapper, test/jest-e2e.json, tsc-alias in the build script, and
    // `tsconfig-paths/register` in the ts-node scripts — and none of them reads
    // baseUrl once the paths are relative. See the alias section of CLAUDE.md.
    "paths": {
      "@/*": ["./src/*"],
      "@generated/*": ["./generated/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
