// Cosmos Pay — payments microservice
// Independent datastore from the developer platform. This service only ever
// receives traffic that has already been authenticated by APISIX (key-auth),
// so it trusts the consumer identity forwarded by the gateway and keys its
// own records to that consumer.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A consumer mirrors the APISIX consumer that authenticated the request.
// We do not store credentials here — only the gateway-provided identity, so
// payments can be attributed and listed per consumer.
model Consumer {
  id             String   @id @default(cuid())
  // The APISIX consumer username, e.g. `cosmos_<userId>` (X-Consumer-Username).
  apisixUsername String   @unique
  // The credential id that authenticated, e.g. `cosmos_<uuid>` (X-Credential-Identifier).
  credentialId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  paymentIntents   PaymentIntent[]
  webhookEndpoints WebhookEndpoint[]
  products         Product[]
  customers        Customer[]
  swaps            Swap[]
  liquidityOps     LiquidityPoolOperation[]

  // BlindPay (onramp/offramp/KYC) resources mirrored from the provider.
  blindpayReceivers BlindpayReceiver[]
  payins            Payin[]
  payouts           Payout[]
  blindpayQuotes    BlindpayQuote[]

  // Pollar OAuth bridge handshakes started by this consumer.
  pollarOauthSessions PollarOauthSession[]

  @@map("consumer")
}

// A merchant-managed customer record. Independent of the payers derived from
// payment intents — these are explicitly created/edited by the merchant.
model Customer {
  id         String   @id @default(cuid())
  consumerId String
  consumer   Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)

  name      String
  // A friendly display alias the merchant can assign (e.g. "Acme — billing").
  alias     String?
  email     String?
  // Optional Stellar account to associate the customer with on-chain activity.
  account   String?
  note      String? // free-form merchant note
  reference String? // merchant reference / external id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([consumerId])
  @@map("customer")
}

// Append-only access log of API requests reaching the service (written by the
// LoggingInterceptor). Powers the dashboard "API logs" view. Scoped by the
// forwarded consumer username when present.
model RequestLog {
  id         String  @id @default(cuid())
  // APISIX consumer username (X-Consumer-Username), null for anonymous/public.
  consumer   String?
  method     String
  path       String
  statusCode Int
  durationMs Int
  ip         String?
  userAgent  String?
  // True for the dashboard's own management-console traffic (X-Cosmos-Internal).
  // The row is ALWAYS written and merely flagged: a request header must never be
  // able to keep a request out of the audit log, or setting it is a free way to
  // make your traffic invisible. The API-log view filters on this column instead.
  internal   Boolean @default(false)

  createdAt DateTime @default(now())

  // Composite covers the dashboard query (filter consumer + order createdAt desc).
  // The former single-column consumer index is a redundant prefix of this one.
  @@index([consumer, createdAt])
  // Used by the retention prune (delete where createdAt < cutoff).
  @@index([createdAt])
  // The API-log view lists external traffic newest-first.
  @@index([internal, createdAt])
  @@map("request_log")
}

// A reusable item/price a merchant can charge for. Independent of payment
// intents — intents may reference one via `reference`, but products are managed
// on their own. Scoped to the APISIX consumer that created them.
model Product {
  id         String   @id @default(cuid())
  consumerId String
  consumer   Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)

  name        String
  description String?
  // Price as a decimal string (e.g. "49.00"). Null = customer-set / donation.
  amount      String?
  asset       String  @default("native") // asset code, or "native" for XLM
  // 'recurring' | 'one_time' | 'link' — informational classification.
  kind        String  @default("one_time")
  active      Boolean @default(true)
  reference   String? // optional merchant SKU / reference

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([consumerId])
  @@map("product")
}

// Events the platform emits to integrators' webhook endpoints.
enum WebhookEventType {
  PAYMENT_INTENT_CREATED
  PAYMENT_INTENT_UPDATED
  PAYMENT_INTENT_SUCCEEDED
  PAYMENT_INTENT_FAILED
  PAYMENT_INTENT_CANCELLED
  PAYMENT_INTENT_DELETED

  // BlindPay-sourced events re-emitted to integrators after we sync state.
  RECEIVER_UPDATED
  PAYIN_CREATED
  PAYIN_UPDATED
  PAYIN_COMPLETED
  PAYOUT_CREATED
  PAYOUT_UPDATED
  PAYOUT_COMPLETED

  // Stellar native swaps (path-payment based asset exchange).
  SWAP_CREATED
  SWAP_SUBMITTED
  SWAP_SUCCEEDED
  SWAP_FAILED

  // Stellar AMM liquidity pool operations (deposit / withdraw).
  LIQUIDITY_CREATED
  LIQUIDITY_SUBMITTED
  LIQUIDITY_SUCCEEDED
  LIQUIDITY_FAILED

  // Appended by `20260824190000_settlement_observer_expiry_safety`. Kept in the
  // declared order PostgreSQL actually stores them in (ADD VALUE appends).
  SWAP_EXPIRED
  LIQUIDITY_EXPIRED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED

  // Appended by `20260826180000_webhook_delivery_retry_queue`. The sweeper does
  // not use it, but an enum value cannot be dropped in place.
  RETRYING
}

// An integrator-registered URL that receives signed event notifications.
// Scoped to the APISIX consumer that created it.
/// Created by `20260825180000_horizon_account_cursor` on main, for the paged
/// Horizon account scan that this branch's verifier does not use. The table is
/// in every deployed database, so it is declared here; it is simply never read.
model HorizonAccountCursor {
  id          String        @id @default(cuid())
  intentId    String        @unique
  intent      PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  network     String // 'public' | 'testnet'
  account     String // G... destination scanned
  pagingToken String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("horizon_account_cursor")
}

model WebhookEndpoint {
  id         String   @id @default(cuid())
  consumerId String
  consumer   Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)

  url                     String
  // HMAC-SHA256 signing secret (prefixed `whsec_`). Integrators verify the
  // `X-Cosmos-Signature` header with this.
  secret                  String
  description             String?
  enabled                 Boolean            @default(true)
  // Set when the URL fails public-destination checks (at register-time audit or
  // at delivery when DNS rebinds to a private/metadata target). Deliveries skip
  // blocked endpoints; clear by PATCHing a safe https URL (or re-enabling after
  // the URL passes validation again).
  destinationBlocked      Boolean            @default(false)
  // Created by `20260825200000_webhook_previous_secret` for main's grace-window
  // rotation. This branch's `rotateSecret` swaps the secret outright, so they
  // are never written; declared to match the deployed database.
  previousSecret          String?
  previousSecretExpiresAt DateTime?
  // Subscribed event types; an empty list means "all events".
  eventTypes              WebhookEventType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([consumerId])
  @@map("webhook_endpoint")
}

// Append-only record of every delivery attempt — the audit trail for what the
// platform notified, when, and whether the integrator acknowledged it.
model WebhookDelivery {
  id         String          @id @default(cuid())
  endpointId String
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  eventType      WebhookEventType
  // Stable event id sent to the receiver for idempotency.
  eventId        String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  responseStatus Int?
  error          String?
  lastAttemptAt  DateTime?
  // ── Columns created by migrations that shipped on main and are already in
  // every deployed database. Nothing on this branch queries them; they stay
  // declared because schema.prisma has to describe the database it points at.
  // `20260826180000_webhook_delivery_retry_queue` added these for the leased
  // retry worker that this branch replaces with the delivery sweeper.
  maxAttempts    Int                   @default(8)
  nextAttemptAt  DateTime?
  leaseUntil     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([endpointId])
  // The plain [status] index was replaced by this composite in
  // `20260826180000_webhook_delivery_retry_queue`. The sweeper filters on
  // `status` alone, which the composite still serves as its leading column.
  @@index([status, nextAttemptAt])
  @@index([eventId])
  // Delivery-log view: filter by endpoint, order createdAt desc.
  @@index([endpointId, createdAt])
  @@map("webhook_delivery")
}

// One row per (operation, terminal event type). Inserting this row is winning
// the right to notify integrators; the unique index on `dedupKey` makes a race
// between the settlement observer and submit produce a single event. Check-
// then-insert is not enough — PostgreSQL enforces uniqueness under concurrency.
model WebhookEmittedEvent {
  id        String           @id @default(cuid())
  // Stable key: "{eventType}:{resourceId}" e.g. "SWAP_SUCCEEDED:clxyz".
  dedupKey  String           @unique
  eventType WebhookEventType
  createdAt DateTime         @default(now())

  @@map("webhook_emitted_event")
}

// Lifecycle of a Stellar payment intent. Kept for traceability — the unsigned
// transaction (xdr/uri) is persisted at creation and the status is advanced as
// the customer signs/submits it on the network.
enum PaymentIntentStatus {
  PENDING // created, unsigned tx handed to the customer
  SUBMITTED // a signed tx hash was reported back to us
  SUCCEEDED // confirmed on the Stellar network
  FAILED // rejected / errored on the network
  CANCELLED // abandoned by the merchant/customer
  EXPIRED // tx time bounds elapsed before submission
}

// How the intent was assembled:
//  - TX:  source known → a full unsigned transaction (xdr) + SEP-7 `tx` URI.
//  - PAY: no source → only a SEP-7 `pay` URI (destination[, amount, asset]); no xdr.
enum PaymentIntentKind {
  TX
  PAY
}

model PaymentIntent {
  id         String   @id @default(cuid())
  consumerId String
  consumer   Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)

  kind PaymentIntentKind @default(TX)

  // Stellar payment details.
  source      String? // payer account (G...) — null for PAY intents
  destination String // payee account (G...)
  amount      String? // decimal string, e.g. "25.5" — optional for PAY intents
  asset       String  @default("native") // asset code, or "native" for XLM
  assetIssuer String? // issuer account for non-native assets
  // Mandatory MEMO_ID (uint64 as string). Auto-generated when not supplied.
  // Identifies the payment on-chain and gives the intent idempotency per consumer.
  memo        String
  network     String // 'public' | 'testnet'

  // Optional SEP-7 extras (informational; echoed back, not validated on-chain).
  msg      String? // message shown to the user in their wallet
  callback String? // SEP-7 callback (e.g. `url:https://...`)

  status PaymentIntentStatus @default(PENDING)

  // Artifacts. `xdr` is null for PAY intents; QR is derived from `uri` on read.
  xdr       String?
  uri       String
  // Set once a signed transaction is submitted/confirmed.
  txHash    String? @unique
  reference String? // optional merchant reference

  // Lifetime: an unpaid intent past this instant is auto-finalized to EXPIRED by
  // the observer. Set at creation from the configured TTL.
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Append-only audit trail of status transitions (issue #36).
  transitions PaymentIntentTransition[]

  // Back-relation for the cursor table below. Virtual — no column.
  horizonCursor HorizonAccountCursor?

  @@unique([consumerId, memo]) // idempotency: one intent per (consumer, memo)
  @@index([consumerId])
  @@index([status])
  // Listing endpoint: filter by consumer, order createdAt desc.
  @@index([consumerId, createdAt])
  // Observer sweep and expiry pass: pending rows oldest-first.
  @@index([status, createdAt])
  // Built by `20260830120000_payment_intent_consumer_source_index` and
  // `20260825210000_analytics_indexes` on main. Declared to match the database.
  @@index([consumerId, source])
  @@index([consumerId, network, createdAt])
  @@map("payment_intent")
}

// Immutable history of every PaymentIntent status change. Written only by the
// single transition() entry point so the ledger cannot diverge from the graph.
model PaymentIntentTransition {
  id       String        @id @default(cuid())
  intentId String
  intent   PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  fromStatus PaymentIntentStatus
  toStatus   PaymentIntentStatus
  txHash     String?
  // Who triggered the change: api | validate | observer | system
  actor      String
  reason     String?

  createdAt DateTime @default(now())

  @@index([intentId, createdAt])
  @@map("payment_intent_transition")
}

// ---------------------------------------------------------------------------
// BlindPay (fiat <-> stablecoin rails): onramp / offramp / KYC.
//
// We run a single platform BlindPay instance (one API key + instance id in env)
// and mirror the provider's resources here, each scoped to the APISIX consumer
// that created it. Status/type/rail/network/token are stored as free-form
// strings (like Product.kind) so new provider values never require a migration.
// `raw` keeps the last full provider payload for audit/debugging.
// ---------------------------------------------------------------------------

// A KYC/KYB entity at BlindPay (their `receiver`/`customer`, id `re_...`).
// Every end user transacting through the rails must exist as a receiver.
model BlindpayReceiver {
  id         String   @id @default(cuid())
  consumerId String
  consumer   Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)

  // BlindPay receiver id (`re_...`).
  blindpayId String
  // 'individual' | 'business'.
  type       String
  // 'light' | 'standard' | 'enhanced'.
  kycType    String?
  // BlindPay KYC status. Receivers start as 'inactive' (created locally, not yet at
  // BlindPay) until the terms-of-service are accepted and the receiver is enabled,
  // at which point this becomes BlindPay's real status — see ReceiversService.
  kycStatus  String?
  email      String?
  name       String?
  country    String?
  externalId String?
  reference  String? // optional merchant reference

  // Last time a terms-of-service link was emailed for this receiver — rate limits the
  // "email me the ToS" action to at most once per day.
  tosSentAt DateTime?

  // Owner/admin kill-switch for this fiat account: when true the receiver cannot be
  // used for onramp/offramp (quotes, payins, payouts, new wallets/bank accounts are
  // refused) regardless of its BlindPay KYC status. Toggled by a platform owner/admin.
  disabled Boolean @default(false)

  raw Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blockchainWallets BlindpayBlockchainWallet[]
  bankAccounts      BlindpayBankAccount[]
  virtualAccounts   BlindpayVirtualAccount[]
  payins            Payin[]
  payouts           Payout[]

  @@unique([consumerId, blindpayId])
  @@index([consumerId])
  // Inbound BlindPay webhooks look a receiver up by provider id alone.
  @@index([blindpayId])
  @@map("blindpay_receiver")
}

// A receiver's blockchain wallet at BlindPay (id `bw_...`). Destination for
// onramp (minted stablecoin) and source for offramp.
model BlindpayBlockchainWallet {
  id         String           @id @default(cuid())
  consumerId String
  receiverId String
  receiver   BlindpayReceiver @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  blindpayId           String // `bw_...`
  name                 String?
  network              String
  address              String?
  isAccountAbstraction Boolean @default(false)

  raw Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([consumerId, blindpayId])
  @@index([consumerId])
  @@index([receiverId])
  @@map("blindpay_blockchain_wallet")
}

// A receiver's fiat bank account at BlindPay (id `ba_...`). Destination for
// offramp payouts. `rail` is the BlindPay rail/type (ach, wire, pix, spei, ...).
model BlindpayBankAccount {
  id         String           @id @default(cuid())
  consumerId String
  receiverId String
  receiver   BlindpayReceiver @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  blindpayId String // `ba_...`
  rail       String?
  name       String?
  country    String?

  raw Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([consumerId, blindpayId])
  @@index([consumerId])
  @@index([receiverId])
  @@map("blindpay_bank_account")
}

// A dedicated fiat account (id `va_...`) that auto-converts incoming fiat into
// stablecoin to the linked blockchain wallet — onramp infrastructure.
model BlindpayVirtualAccount {
  id         String           @id @default(cuid())
  consumerId String
  receiverId String
  receiver   BlindpayReceiver @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  blindpayId         String // `va_...`
  blockchainWalletId String?
  token              String?
  status             String?

  raw Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([consumerId, blindpayId])
  @@index([consumerId])
  @@index([receiverId])
  @@map("blindpay_virtual_account")
}

// Onramp (fiat -> stablecoin). Created from a payin quote; carries the payment
// instructions the payer follows (memo/CLABE/PIX/CBU/PSE/bank details).
model Payin {
  id         String            @id @default(cuid())
  consumerId String
  consumer   Consumer          @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  receiverId String?
  receiver   BlindpayReceiver? @relation(fields: [receiverId], references: [id], onDelete: SetNull)

  blindpayId     String // `pi_...`
  quoteId        String?
  status         String?
  token          String?
  network        String?
  paymentMethod  String? // rail used to pay in
  currency       String?
  senderAmount   String?
  receiverAmount String?
  // Provider-supplied instructions the payer follows to fund the payin.
  instructions   Json?

  raw Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([consumerId, blindpayId])
  @@index([consumerId])
  @@index([receiverId])
  @@index([status])
  // Inbound BlindPay webhooks look a payin up by provider id alone.
  @@index([blindpayId])
  @@map("payin")
}

// Offramp (stablecoin -> fiat). Created from a payout quote; the customer signs
// the on-chain transfer (we never hold keys), funds settle to a bank account.
model Payout {
  id         String            @id @default(cuid())
  consumerId String
  consumer   Consumer          @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  receiverId String?
  receiver   BlindpayReceiver? @relation(fields: [receiverId], references: [id], onDelete: SetNull)

  blindpayId          String // `pa_...`
  quoteId             String?
  status              String?
  token               String?
  network             String?
  rail                String?
  bankAccountId       String?
  senderAmount        String?
  receiverAmount      String?
  senderWalletAddress String?

  raw Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([consumerId, blindpayId])
  @@index([consumerId])
  @@index([receiverId])
  @@index([status])
  // Inbound BlindPay webhooks look a payout up by provider id alone; without
  // this the composite above cannot serve the query (blindpayId is its second
  // column), so every webhook was a sequential scan.
  @@index([blindpayId])
  @@map("payout")
}

/// Ownership record for a BlindPay quote.
///
/// BlindPay quote ids are opaque strings minted upstream on a platform instance
/// shared by every tenant, so a quote id alone proves nothing about who owns it.
/// Executing a payin/payout used to forward the caller's `quote_id` straight
/// through, which let one tenant execute another tenant's quote and have the
/// result mirrored into their own records. Every quote this service creates is
/// recorded here at creation, and execution resolves it by (consumer, quote id)
/// before the upstream call.
model BlindpayQuote {
  id         String   @id @default(cuid())
  consumerId String
  consumer   Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)

  /// The upstream BlindPay quote id (`pq_…` for payins, `qu_…` for payouts).
  blindpayId String
  kind       BlindpayQuoteKind

  createdAt DateTime @default(now())

  @@unique([consumerId, blindpayId])
  @@index([consumerId])
  @@map("blindpay_quote")
}

enum BlindpayQuoteKind {
  PAYIN
  PAYOUT
}

/// Inbound BlindPay (Svix) webhook de-duplication.
///
/// Svix retries a delivery until it is acknowledged, re-sending the same
/// `svix-id`. Without a claim row each retry re-applied the update and re-emitted
/// an outbound notification, so an integrator saw "payout completed" more than
/// once for one event. The unique index is the claim: the first delivery to
/// insert the row wins and processes; a retry hits the constraint and is dropped.
model BlindpayWebhookEvent {
  id        String   @id @default(cuid())
  /// The `svix-id` header — stable across retries of the same event.
  svixId    String   @unique
  eventType String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("blindpay_webhook_event")
}

// ---------------------------------------------------------------------------
// Stellar native swaps (asset exchange via path payments).
//
// Stellar has no "swap" primitive — asset exchange is a `PathPaymentStrictSend`
// operation that routes through the DEX order books and AMM liquidity pools to
// the best available path. This service is **non-custodial**: it only quotes,
// assembles the unsigned transaction (a platform fee payment + the path payment)
// and submits the signed transaction the customer hands back. Funds never pass
// through Cosmos Pay. Scoped to the APISIX consumer like every other resource.
// ---------------------------------------------------------------------------
enum SwapStatus {
  PENDING // built, unsigned XDR handed to the customer
  SUBMITTED // a signed tx was submitted to the network
  SUCCEEDED // confirmed on the Stellar network
  FAILED // rejected / errored on the network
  EXPIRED // tx time bounds elapsed before submission
}

model Swap {
  id         String   @id @default(cuid())
  consumerId String
  consumer   Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)

  network     String // 'public' | 'testnet'
  // Account paying (and signing) the swap.
  source      String
  // Account credited the destination asset (defaults to `source` — a self-swap).
  destination String

  // Source side (asset sold). `sendAmount` is the gross input; the platform fee
  // is deducted from it and `swapAmount` (= sendAmount - feeAmount) is routed.
  sendAsset       String  @default("native") // asset code, or "native" for XLM
  sendAssetIssuer String?
  sendAmount      String
  feeAmount       String
  feeBps          Int
  swapAmount      String

  // Destination side (asset bought). `destEstimated` is the quote at build time;
  // `destMin` is the slippage-protected minimum enforced on-chain (destMin).
  destAsset       String  @default("native")
  destAssetIssuer String?
  destEstimated   String
  destMin         String
  slippageBps     Int
  // Intermediate hops chosen by the path search: [{ code, issuer }] (or empty).
  path            Json

  // Optional MEMO_ID echoed on-chain for the merchant's own reconciliation.
  memo String?

  // Client-supplied idempotency key (Idempotency-Key header or DTO field).
  // NULL when omitted — PostgreSQL treats NULLs as distinct, so multiple
  // swaps without a key remain allowed for the same consumer.
  idempotencyKey String?

  status          SwapStatus @default(PENDING)
  // Bumped only on FAILED → SUBMITTED (a real resubmit). Terminal webhook
  // dedup keys include this so a later SWAP_FAILED is not collapsed into the
  // first attempt, while observer+submit of the same attempt still share a key.
  settlementEpoch Int        @default(0)
  // Unsigned transaction envelope + its SEP-7 `tx` deep link. QR derived on read.
  xdr             String
  uri             String
  // Deterministic transaction hash (computed at build, verified on submit).
  txHash          String

  expiresAt DateTime?

  // ── Columns created by migrations that shipped on main and are already in
  // every deployed database. The services that read them were superseded by
  // this branch's design, so nothing queries them today; they stay declared
  // because schema.prisma has to describe the database it points at, and
  // dropping live columns (and an enum value, which PostgreSQL cannot remove
  // without recreating the type) buys nothing.
  lastCheckedAt  DateTime?
  notFoundStreak Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Idempotency: one swap per (consumer, key) when a key is supplied.
  @@unique([consumerId, idempotencyKey])
  // Prevents two PENDING rows sharing the same on-chain tx (sequence collision).
  @@unique([network, txHash])
  @@index([consumerId])
  @@index([status])
  // Listing endpoint: filter by consumer, order createdAt desc.
  @@index([consumerId, createdAt])
  // Observer sweep: pending rows oldest-first.
  @@index([status, createdAt])
  @@map("swap")
}

// ---------------------------------------------------------------------------
// Stellar AMM liquidity pool operations. Like swaps, these are non-custodial:
// the service prices the deposit/withdraw against the pool's on-chain reserves,
// builds the unsigned transaction (changeTrust for the pool share if needed +
// liquidityPoolDeposit/liquidityPoolWithdraw) and relays the signed envelope
// the customer hands back. Reuses SwapStatus — the lifecycle is identical.
// ---------------------------------------------------------------------------
enum LiquidityOperationKind {
  DEPOSIT
  WITHDRAW
}

model LiquidityPoolOperation {
  id         String   @id @default(cuid())
  consumerId String
  consumer   Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)

  kind    LiquidityOperationKind
  network String // 'public' | 'testnet'
  // Account paying for (and signing) the operation.
  source  String
  // Stellar liquidity pool id (64-char hex).
  poolId  String

  // The pool's constituent assets in canonical (protocol) order: A < B.
  assetA       String  @default("native")
  assetAIssuer String?
  assetB       String  @default("native")
  assetBIssuer String?

  // DEPOSIT: maxAmountA/maxAmountB caps + minPrice/maxPrice bounds (A/B ratio).
  // WITHDRAW: shares burned + amountA/amountB as slippage-protected minimums.
  amountA  String
  amountB  String
  shares   String?
  minPrice String?
  maxPrice String?

  slippageBps Int

  // Client-supplied idempotency key (Idempotency-Key header or DTO field).
  // NULL when omitted — PostgreSQL treats NULLs as distinct, so multiple
  // operations without a key remain allowed for the same consumer.
  idempotencyKey String?

  // Platform (plan) commission. Charged ONLY on WITHDRAW, and only on the
  // *gain* (redeemed − proportional cost basis), never on the principal — so
  // deposits carry no commission (feeBps 0, feeWallet null). feeAmountA/B are
  // the commission paid to feeWallet out of each just-withdrawn reserve.
  feeBps     Int     @default(0)
  feeAmountA String  @default("0")
  feeAmountB String  @default("0")
  feeWallet  String?

  // Cost basis, captured from the on-chain `liquidity_pool_deposited` effect
  // once a DEPOSIT settles (null until then / for withdrawals). Used to work out
  // the gain a later withdraw is taxed on (average-cost across our deposits).
  sharesReceived String?
  settledAmountA String?
  settledAmountB String?

  status          SwapStatus @default(PENDING)
  // Same meaning as Swap.settlementEpoch — resubmit discriminator for
  // LIQUIDITY_FAILED dedup (issue #29).
  settlementEpoch Int        @default(0)

  // Unsigned transaction envelope + its SEP-7 `tx` deep link. QR derived on read.
  xdr    String
  uri    String
  // Deterministic transaction hash (computed at build, verified on submit).
  txHash String

  expiresAt DateTime?

  // ── Columns created by migrations that shipped on main and are already in
  // every deployed database. Nothing on this branch queries them; they stay
  // declared because schema.prisma has to describe the database it points at.
  lastCheckedAt  DateTime?
  notFoundStreak Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Idempotency: one operation per (consumer, key) when a key is supplied.
  // NULLs stay distinct, so keyless operations remain unrestricted.
  @@unique([consumerId, idempotencyKey])
  // Prevents two rows sharing one on-chain tx (identical XDR / sequence
  // collision), which produced duplicate LIQUIDITY_* webhooks for a single
  // deposit. Swap has carried this since issue #17; LP never received it.
  @@unique([network, txHash])
  @@index([consumerId])
  @@index([status])
  @@index([poolId])
  // Listing endpoint: filter by consumer, order createdAt desc.
  @@index([consumerId, createdAt])
  // Observer sweep: pending rows oldest-first.
  @@index([status, createdAt])
  @@map("liquidity_pool_operation")
}

// ---------------------------------------------------------------------------
// Platform-admin audit trail (issue #34). Append-only: no update/delete API.
// ---------------------------------------------------------------------------
model AdminAuditLog {
  id           String   @id @default(cuid())
  actorId      String
  actorRole    String
  action       String
  resourceType String
  resourceId   String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([resourceType, resourceId])
  @@map("admin_audit_log")
}

// ---------------------------------------------------------------------------
// Pollar OAuth bridge.
//
// Pollar mints its own end-user session from a hosted OAuth flow, but that flow
// only ever returns the browser to a `redirect_uri` Pollar has been told about.
// A wallet that completes the code exchange locally cannot register a loopback
// or a custom scheme there, and must not hold the Pollar keys. So the bridge
// owns the Pollar half of the handshake: it mints the Pollar client session,
// assembles the authorization URL, receives the browser back on its own
// callback, and hands the wallet a single-use code of its own to redeem.
//
// A row is a bridge handshake in flight. It never holds a Pollar token: the
// `/auth/login` exchange runs during the redemption call and its result goes
// straight to the wallet.
// ---------------------------------------------------------------------------
enum PollarOauthStatus {
  // Authorization URL handed out; waiting for the browser to come back.
  PENDING
  // The callback fired and a single-use bridge code was minted.
  AUTHORIZED
  // A redemption is in flight (guards against a concurrent double redeem).
  EXCHANGING
  // The code was redeemed for a Pollar session. Terminal.
  CONSUMED
  // The handshake failed and cannot be retried. Terminal.
  FAILED
  // The handshake ran out of time before the code was redeemed. Terminal.
  EXPIRED
}

model PollarOauthSession {
  id         String   @id @default(cuid())
  consumerId String
  consumer   Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)

  // Opaque bridge handle. Travels in the browser URL (callback path) and back
  // to the wallet, so it is a random 32-byte value and never a guessable id.
  state    String            @unique
  provider String // 'google' | 'github'
  status   PollarOauthStatus @default(PENDING)
  // Which Pollar key pair this handshake was started with, so the redemption
  // talks to the same network the authorization URL was built for.
  network  String

  // Pollar's own client session id, from POST /auth/session. The wallet never
  // sees it — it is what the bridge redeems at POST /auth/login.
  clientSessionId String

  // Where the wallet wants the bridge code delivered. Null means poll mode: the
  // wallet has no addressable redirect and reads the code back from the bridge.
  redirectUri   String?
  // PKCE (RFC 7636) challenge, S256 only. Optional, enforced when present.
  codeChallenge String?

  // The wallet's DPoP public JWK, forwarded to Pollar so the minted tokens are
  // bound to the WALLET's key rather than to the bridge. When set, the bridge
  // can no longer refresh or revoke on the wallet's behalf — only the holder of
  // the private key can — which is exactly the point.
  dpopJwk     Json?
  deviceLabel String?

  // SHA-256 of the single-use bridge code. The code itself is never stored, so
  // a database read cannot redeem a handshake.
  codeHash      String?   @unique
  codeExpiresAt DateTime?

  // Public identity of the resulting Pollar wallet, kept for support and for
  // the poll response. No token and no profile PII is ever persisted.
  walletAddress String?
  walletType    String?
  pollarUserId  String?

  // Pollar's error code when the handshake ended in FAILED/EXPIRED.
  errorCode String?

  // Deadline for the whole handshake, independent of the code's shorter TTL.
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([consumerId, createdAt])
  // The sweeper expires stale handshakes oldest-first.
  @@index([status, expiresAt])
  @@map("pollar_oauth_session")
}

// ---------------------------------------------------------------------------
// Rate limiting.
//
// One row per (policy + subject, window). The counter lives in Postgres rather
// than in each replica's memory on purpose: the service runs behind APISIX,
// which load-balances, so an in-process limiter would grant every replica the
// full budget and quietly multiply the limit by the replica count. That is
// tolerable for a cosmetic throttle and not tolerable for the thing this
// actually guards — wallet creation, which spends XLM out of the funding
// account on every call.
//
// Fixed window, not sliding: two full bursts can straddle a boundary, so the
// real worst case is 2x the limit per window. That is a deliberate trade for a
// single atomic upsert per request, and it still bounds the spend.
// ---------------------------------------------------------------------------
model RateLimitCounter {
  // `<policy>:<consumer>:<ip subject>` — see RateLimitService.
  key         String
  // Start of the fixed window this count belongs to.
  windowStart DateTime
  count       Int      @default(0)
  // When the row stops being needed. Read only by the prune job.
  expiresAt   DateTime

  @@id([key, windowStart])
  // The prune deletes by deadline, oldest first.
  @@index([expiresAt])
  @@map("rate_limit_counter")
}
