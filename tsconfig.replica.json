{
  // The second local replica (`npm run dev:replica`). Its own outDir, because two
  // `nest start --watch` processes compiling into the same dist/ clobber each other
  // mid-build; everything else is the normal build.
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "outDir": "./dist-replica"
  },
  "exclude": ["node_modules", "test", "dist", "dist-replica", "plugins", "**/*spec.ts"]
}
